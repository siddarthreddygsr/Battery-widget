<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/widget_phone_slot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_phone_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/phone"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ring_placeholder" />

        <TextView
            android:id="@+id/widget_phone_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_left_slot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_left_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/left"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ring_placeholder" />

        <TextView
            android:id="@+id/widget_left_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_right_slot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_right_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/right"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ring_placeholder" />

        <TextView
            android:id="@+id/widget_right_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_case_slot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_case_ring"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="@string/case_label"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_ring_placeholder" />

        <TextView
            android:id="@+id/widget_case_percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
