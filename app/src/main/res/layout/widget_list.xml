<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_blur"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_phone_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/phone"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_phone_name"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/phone"
            android:textColor="#3A3A3C"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_phone_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_phone_percent"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_left_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/left"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_left_name"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/left"
            android:textColor="#3A3A3C"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_left_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_left_percent"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_right_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/right"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_right_name"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/right"
            android:textColor="#3A3A3C"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_right_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_right_percent"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_case_icon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/case_label"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/widget_case_name"
            android:layout_width="56dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/case_label"
            android:textColor="#3A3A3C"
            android:textSize="13sp" />

        <ProgressBar
            android:id="@+id/widget_case_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginHorizontal="8dp"
            android:layout_weight="1"
            android:max="100"
            android:progressDrawable="@drawable/widget_bar" />

        <TextView
            android:id="@+id/widget_case_percent"
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="—"
            android:textColor="#1C1C1E"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
